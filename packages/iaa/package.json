{
  "name": "@chuo-gpa/iaa",
  "version": "0.1.0",
  "description": "IAA (Institute of Accountancy Arusha) GPA calculator — powered by Chuo-GPA",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "keywords": ["gpa", "iaa", "tanzania", "university", "arusha", "accountancy"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",

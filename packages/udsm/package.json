{
  "name": "@chuo-gpa/udsm",
  "version": "0.1.0",
  "description": "UDSM (University of Dar es Salaam) GPA calculator — powered by Chuo-GPA",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gpa",
    "udsm",
    "tanzania",
    "university",
    "dar-es-salaam"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@chuo-gpa/core": "workspace:*",
    "@chuo-gpa/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "rimraf": "^6.0.0"
  }
}
